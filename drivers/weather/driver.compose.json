{
    "id": "weather",
    "name":
    {
        "en": "Weather Station",
        "nl": "Weerstation",
        "de": "Wetterstation",
        "fr": "Staion météorologique"
    },
    "platforms": [
        "local"
    ],
    "connectivity": [
        "cloud"
    ],
    "class": "sensor",
    "capabilities": [
        "measure_temperature",
        "measure_temperature.feelsLike",
        "measure_temperature.dewPoint",
        "measure_humidity",
        "measure_pressure",
        "measure_wind_angle",
        "measure_wind_direction",
        "measure_wind_strength",
        "measure_gust_strength",
        "measure_rain",
        "measure_rain.total",
        "measure_ultraviolet",
        "measure_radiation",
        "measure_luminance",
        "button.send_log"
    ],
    "capabilitiesOptions":
    {
        "measure_luminance":
        {
            "title":
            {
                "en": "Approximate Luminance",
                "nl": "Geschatte lichtsterkte",
                "de": "Geschätzte Beleuchtungsstärke",
                "fr": "Luminosité approximative"
            }
        },
        "measure_temperature.feelsLike":
        {
            "title":
            {
                "en": "Feels Like",
                "nl": "Gevoelstemperatuur",
                "de": "Gefühlte Temperatur",
                "fr": "Température resentie"
            }
        },
        "measure_temperature.dewPoint":
        {
            "title":
            {
                "en": "Dew point",
                "nl": "Dauwpunt",
                "de": "Taupunkt",
                "fr": "Point de rosée"
            }
        },
        "measure_rain":
        {
            "units":
            {
                "en": "mm/hr"
            }
        },
        "measure_rain.total":
        {
            "title":
            {
                "en": "Rain Total",
                "nl": "Regen Totaal",
                "de": "Regenmenge",
                "fr": "Quantité totale de pluie"
            }
        },
        "measure_ultraviolet":
        {
            "title":
            {
                "en": "UV-Index",
                "de": "UV-Index",
                "fr": "Index UV"
            }
        },
        "measure_pressure":
        {
            "title":
            {
                "en": "Relative Pressure",
                "nl": "Relatieve druk",
                "de": "Relativer Druck",
                "fr": "Pression relative"
            }
        },
        "button.send_log": {
            "maintenanceAction": true,
            "title": {
                "en": "Send Diagnostics Log",
                "fr": "Envoyer le journal de diagnostic"

            },
            "desc": {
                "en": "Send a diagnostics log to the developer",
                "fr": "Envoyer un journal de diagnostic au développeur"
            }
        }
    },
    "pair": [
    {
        "id": "weather_pair"
    } ],
    "settings": [
    {
        "type": "group",
        "label":
        {
            "en": "Approximate Luminance",
            "nl": "Geschatte lichtsterkte",
            "de": "Geschätzte Beleuchtungsstärke",
            "fr": "Luminosité approximative"
        },
        "children": [
        {
            "id": "luminanceEnabled",
            "type": "checkbox",
            "value": false,
            "label":
            {
                "en": "Enable approximate luminance",
                "nl": "Geschatte lichtsterkte inschakelen",
                "de": "Geschätzte Beleuchtungsstärke aktivieren",
                "fr": "Activer la luminosité approximative"
            },
            "hint":
            {
                "en": "Estimate outdoor illuminance in lux by multiplying solar radiation (W/m²) by the conversion factor. This is not a direct light measurement and accuracy varies with conditions and the sensor.",
                "nl": "Schat de lichtsterkte buiten in lux door de zonnestraling (W/m²) te vermenigvuldigen met de omrekenfactor. Dit is geen directe lichtmeting; de nauwkeurigheid hangt af van de omstandigheden en de sensor.",
                "de": "Schätzt die Beleuchtungsstärke im Freien in Lux, indem die Sonneneinstrahlung (W/m²) mit dem Umrechnungsfaktor multipliziert wird. Dies ist keine direkte Lichtmessung; die Genauigkeit hängt von den Bedingungen und dem Sensor ab.",
                "fr": "Estime l'éclairement extérieur en lux en multipliant le rayonnement solaire (W/m²) par le facteur de conversion. Ce n'est pas une mesure directe ; la précision dépend des conditions et du capteur."
            }
        },
        {
            "id": "luminanceFactor",
            "type": "number",
            "value": 126,
            "min": 0.01,
            "step": 0.01,
            "label":
            {
                "en": "Conversion factor",
                "nl": "Omrekenfactor",
                "de": "Umrechnungsfaktor",
                "fr": "Facteur de conversion"
            },
            "hint":
            {
                "en": "Lux = solar radiation × factor. Default: 126. Adjust using a separate lux meter.",
                "nl": "Lux = zonnestraling × factor. Standaard: 126. Pas aan met behulp van een aparte luxmeter.",
                "de": "Lux = Sonneneinstrahlung × Faktor. Standard: 126. Mit einem separaten Luxmeter anpassen.",
                "fr": "Lux = rayonnement solaire × facteur. Valeur par défaut : 126. Ajustez à l'aide d'un luxmètre séparé."
            }
        } ]
    },
    {
        "type": "group",
        "label":
        {
            "en": "Station Details",
            "nl": "Station detail informatie",
            "de": "Stationsdetails",
            "fr": "Détail de la station"
        },
        "children": [
        {
            "id": "stationID",
            "type": "text",
            "label":
            {
                "en": "Station ID",
                "nl": "Station ID",
                "de": "Station ID",
                "fr": "ID de la station"
            }
        },
        {
            "id": "apiKey",
            "type": "text",
            "label":
            {
                "en": "API Key",
                "nl": "API Sleutel",
                "de": "API Key",
                "fr": "Clé API"
            }
        } ]
    } ],
    "images":
    {
        "large": "/drivers/weather/assets/images/large.png",
        "small": "/drivers/weather/assets/images/small.png"
    },
    "icon": "/drivers/weather/assets/icon.svg"
}
